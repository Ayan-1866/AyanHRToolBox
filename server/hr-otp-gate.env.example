# Copy to /etc/hr-otp-gate.env on the server, fill in, then:  chmod 600 /etc/hr-otp-gate.env
# Never commit the filled-in copy.

# Gmail / Google Workspace account that sends the code, and its 16-letter App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER=hr@alcoverealty.in
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Who may receive a code and open the portal (comma-separated)
ALLOWED_EMAILS=hr@alcoverealty.in

# Long random text so sign-ins survive restarts. Create one with:  openssl rand -hex 32
SESSION_SECRET=

# How long a sign-in lasts, in hours
SESSION_HOURS=12

# The portal path being protected
PROTECT_PREFIX=/p/hr-tool-box/

# Where the gate listens (only reachable from the web server on the same machine)
BIND=127.0.0.1
PORT=8090
